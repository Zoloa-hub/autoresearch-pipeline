# Auto-Research 配置示例
# ---------------------------------------------------------------
# 复制成 `.env` 并填入真实值。`.env` 已在 .gitignore 中，不会入库。
# 优先级：CLI 参数 > AUTORESEARCH_* 环境变量 > .env > 默认值
# ---------------------------------------------------------------

# ---- DeepSeek（推荐：便宜、中文强、OpenAI 兼容）----
DEEPSEEK_API_KEY=sk-在此填入你的密钥
AUTORESEARCH_LLM_PROVIDER=deepseek
AUTORESEARCH_MODEL=deepseek-chat

# ---- 或 OpenAI 官方 ----
# OPENAI_API_KEY=sk-...
# AUTORESEARCH_LLM_PROVIDER=openai
# AUTORESEARCH_MODEL=gpt-4o

# ---- 或任意 OpenAI 兼容端点（vLLM / Ollama / 自建代理）----
# AUTORESEARCH_LLM_PROVIDER=openai
# AUTORESEARCH_BASE_URL=http://localhost:11434/v1
# AUTORESEARCH_MODEL=llama3.1

# ---- 运行默认值（可选）----
# AUTORESEARCH_VENUE=NeurIPS
# AUTORESEARCH_LANGUAGE=zh
# AUTORESEARCH_SANDBOX_BACKEND=subprocess
# AUTORESEARCH_MAX_TOKENS=8192          # 默认 8192；deepseek 由 provider 默认值抬到 32768
# AUTORESEARCH_MAX_REVIEW_ROUNDS=3
# AUTORESEARCH_MAX_DEBUG_ROUNDS=4
# AUTORESEARCH_MAX_VARIANTS=6           # 单次运行的臂数上限（主对照+消融格点）
# AUTORESEARCH_SEED=0

# ---- 实验后端（可选；留空则用内置合成任务）----
# AUTORESEARCH_EXPERIMENT_ADAPTER=script-wrapper
# 适配器参数只能通过 CLI 的 --adapter-arg 传（.env 不支持结构化值）：
#   python -m autoresearch.cli run --direction "..." \
#       --experiment-adapter script-wrapper \
#       --adapter-arg script=my_train.py --adapter-arg program=torchrun
# 详见 docs/adapters.md

